// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 用户基础表（登录用）
model User {
  id        String   @id @default(uuid())
  phone     String   @unique // 手机号登录
  password  String   // bcrypt 加密
  role      Role     @default(RUNNER) // BOSS | RUNNER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关联跑手资料（只有 role=RUNNER 时才有）
  runnerProfile RunnerProfile?

  // 关联订单（作为下单用户）
  orders Order[]

  // 关联评价（作为评价人）
  reviews Review[]

  // 关联通知
  notifications Notification[]
}

enum Role {
  BOSS
  RUNNER
  ADMIN // 预留：后续扩展管理员
}

// 跑手扩展信息表
model RunnerProfile {
  id          String     @id @default(uuid())
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 基础信息
  nickname    String     // 昵称
  avatar      String?    // 头像 URL
  phone       String     // 联系手机号（可与登录手机号不同）
  wechat      String?    // 微信号（可选，与手机号二选一）

  // 业务信息
  platform    Platform   // PC | MOBILE | BOTH
  bio         String?    // 简介
  pricePer10M Int        // 每1000万哈夫币价格（元）

  // 状态
  status      RunnerStatus     @default(OFFLINE) // ONLINE | OFFLINE | BUSY
  rating      Float      @default(5.0)      // 评分 0-5
  ordersCount Int        @default(0)         // 完成订单数

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // 关联订单（作为接单跑手）
  receivedOrders Order[]

  // 关联评价
  reviews Review[]
}

enum Platform {
  PC         // 端游
  MOBILE     // 手游
  BOTH       // 两者都可
}

enum RunnerStatus {
  ONLINE
  OFFLINE
  BUSY
}

// 订单模式枚举
enum OrderMode {
  PRIVATE // 指定跑手
  PUBLIC  // 公开发布，可抢单
}

// 订单表
model Order {
  id          String      @id @default(uuid())

  // 关联下单用户
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 关联跑手（PUBLIC 模式下可为 null，抢单后填充）
  runnerId    String?
  runner      RunnerProfile? @relation(fields: [runnerId], references: [id], onDelete: Cascade)

  // 订单模式
  mode        OrderMode   @default(PRIVATE)

  // 订单状态
  status      OrderStatus @default(PENDING)

  // 抢单相关（仅 PUBLIC 模式使用）
  claimDeadline DateTime? // 抢单截止时间
  claimedAt   DateTime?   // 抢单成功时间

  // 金额（元）
  amount      Int

  // 游戏相关（可选，后续扩展）
  gameAmount  Int?        // 游戏币数量（万）
  note        String?     // 订单备注

  // 进度追踪（0-100）
  progress    Int         @default(0)
  progressNote String?    // 进度说明（如：正在匹配中、游戏中等）

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // 关联评价（一个订单只能有一条评价）
  review Review?

  // 关联订单日志
  logs OrderLog[]

  @@index([userId])
  @@index([runnerId])
  @@index([status])
  @@index([mode])
  @@index([claimDeadline])
}

enum OrderStatus {
  PENDING     // 待接单
  ACCEPTED    // 已接单
  IN_PROGRESS // 进行中（新增）
  COMPLETED   // 已完成
  CANCELED    // 已取消
}

// 订单日志表（类似快递轨迹）
model OrderLog {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  // 谁创建的日志
  actorType   String   // 'BOSS' | 'RUNNER' | 'SYSTEM'
  actorId     String
  
  // 日志内容
  action      String   // 动作类型：ACCEPT, UPDATE_PROGRESS, COMPLETE, CANCEL 等
  message     String   // 日志消息
  
  // 可选：进度变化
  progressFrom Int?
  progressTo   Int?
  
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
}

// 评价表
model Review {
  id          String      @id @default(uuid())

  // 关联订单
  orderId     String      @unique
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // 关联评价人（BOSS）
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 关联跑手
  runnerId    String
  runner      RunnerProfile @relation(fields: [runnerId], references: [id], onDelete: Cascade)

  // 评分 1-5
  rating      Int

  // 评论内容
  comment     String?

  createdAt   DateTime    @default(now())

  @@index([orderId])
  @@index([userId])
  @@index([runnerId])
}

// 通知表
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type      String   // ORDER_CLAIMED | ORDER_COMPLETED | ORDER_CANCELLED
  title     String
  message   String
  orderId   String?
  
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
}
